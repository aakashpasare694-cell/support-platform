NODE_ENV=development
APP_ENV=local
PORT=8900
# Comma-separated origins allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:3040

# ─── Database ───────────────────────────────────────────────────────────────
DB_FILE=./data/support-platform.db

# ─── Auth ───────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=dev-only-change-me-must-be-at-least-32-characters-long
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ─── Provider credential encryption (AES-256-GCM) ───────────────────────────
# openssl rand -base64 32   → must decode to exactly 32 bytes
CREDENTIALS_MASTER_KEY=

# ─── Cache / rate limiting (optional: falls back to in-memory locally) ──────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_PREFIX=sp

# ─── Inbound email ──────────────────────────────────────────────────────────
# openssl rand -hex 32  — the shared secret a mail source must present
INBOUND_WEBHOOK_SECRET=
# Domain our outgoing Message-IDs are stamped with
INGEST_DOMAIN=incomingmail.charityerp.com

# ─── Default (bootstrap) email provider ─────────────────────────────────────
# Inserted once on first seed, then guarded by the settings flag
# `email_bootstrap_completed` so a redeploy never overwrites admin config.
#
# Mailpit is an SMTP sink: it accepts every message and delivers none, so
# nothing can reach a real customer while testing. Start it with `mailpit`
# and read what was sent at http://localhost:8025
DEFAULT_EMAIL_PROVIDER_TYPE=mailpit
DEFAULT_EMAIL_PROVIDER_NAME=Mailpit (local)
DEFAULT_EMAIL_PROVIDER_SENDER_EMAIL=support@charityerp.com
DEFAULT_EMAIL_PROVIDER_SENDER_NAME=Charity ERP Support
# Mailpit's WEB UI port — its HTTP send API lives here, not on SMTP 1025.
MAILPIT_BASE_URL=http://127.0.0.1:8025
# Only if Mailpit was started with --ui-auth user:pass
MAILPIT_USERNAME=
MAILPIT_PASSWORD=

# ─── Local inbound testing: poll a real mailbox over IMAP ───────────────────
# No DNS, no tunnel, no public exposure — the same approach as Freshdesk's
# "custom mailbox" mode.  npm run poll:mail -- --watch
# Gmail needs an App Password (2-Step Verification on):
#   https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
