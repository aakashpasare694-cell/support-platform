{
  "name": "support-platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Centralized multi-product support platform — API. Runs on Node locally and Cloudflare Workers in production.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:status": "tsx scripts/migrate.ts --status",
    "seed": "tsx scripts/seed.ts",
    "bootstrap:email": "tsx scripts/bootstrap-email.ts",
    "poll:mail": "tsx scripts/poll-mailbox.ts",
    "seed:d1": "tsx scripts/generate-d1-seed.ts",
    "db:check": "tsx scripts/db-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:workers": "node scripts/check-workers-compat.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "check:permissions": "node scripts/check-permissions.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@upstash/redis": "^1.34.3",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "kysely": "^0.27.5",
    "kysely-d1": "^0.4.0",
    "postal-mime": "^2.7.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@hono/node-server": "^1.13.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "imapflow": "^2.12.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
